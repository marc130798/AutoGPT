# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Taleria ---
# Das Haupt-Repo ignoriert "lib/" (Python). Für Flutter brauchen wir den Ordner.
!lib/
# Zugangsdaten für Test und Live, nie committen. Nur die *.example.json-Vorlagen kommen ins Git.
!env/
env/*.json
!env/*.example.json
# Supabase-CLI, lokale Dateien
supabase/.branches
supabase/.temp
supabase/.env

# Ton-Dateien der App (die .gitignore ganz oben im Repository schließt *.mp3 aus)
!*.mp3
